# DataPulse Environment Configuration

# Deployment Mode: local | aws
DEPLOYMENT_MODE=local

# Storage Configuration
# local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data
S3_BUCKET_NAME=datapulse-data-lake-dev
AWS_REGION=us-east-1

# Warehouse Configuration
# postgres | redshift
WAREHOUSE_BACKEND=postgres
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_DB=datapulse_dw
WAREHOUSE_USER=postgres
WAREHOUSE_PASSWORD=postgres
WAREHOUSE_SCHEMA=analytics

# Processing Configuration
# spark | pandas
PROCESSING_ENGINE=spark
SPARK_MASTER=local[*]
SPARK_APP_NAME=DataPulse-ETL

# Quality Gate Thresholds
QUALITY_THRESHOLD_PERCENT=95.0
MAX_DUPLICATE_RATE=0.02
MAX_NULL_KEY_RATE=0.00

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Notification / Alerting
ALERT_WEBHOOK_URL=
